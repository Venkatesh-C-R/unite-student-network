# Copy this file to .env (and to .env.test for `npm test`) and fill in the values.
# Never commit .env or .env.test: they hold the database password and session secret.

NODE_ENV=development
PORT=4000
# The website's address; requests from any other origin are refused
APP_ORIGIN=http://localhost:5173
# Any long random text, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# MySQL (create the database first: CREATE DATABASE unite;)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Use unite for .env and unite_test for .env.test
DB_NAME=unite

# Email for sign-in codes: console (codes printed in the backend terminal), brevo or resend
MAIL_PROVIDER=console
MAIL_FROM=UNITE <no-reply@example.com>
BREVO_API_KEY=
RESEND_API_KEY=

# Where uploaded evidence files are saved (default: backend/uploads)
# UPLOAD_DIR=uploads

# Optional, development only: a fixed 6-digit sign-in code for the seeded demo accounts
DEMO_LOGIN_CODE=
